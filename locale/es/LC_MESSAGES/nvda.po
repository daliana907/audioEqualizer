msgid "Abre el diálogo de configuración del ecualizador de audio."
msgstr "Abre el diálogo de configuración del ecualizador de audio."

msgid "Activa o desactiva el filtro anti-encajonamiento (400 Hz)."
msgstr "Activa o desactiva el filtro anti-encajonamiento (400 Hz)."

msgid "Activa o desactiva el filtro anti-sibilancia para suavizar el seseo."
msgstr "Activa o desactiva el filtro anti-sibilancia para suavizar el seseo."

msgid "Activa o desactiva el filtro contra la fatiga auditiva."
msgstr "Activa o desactiva el filtro contra la fatiga auditiva."

msgid "Activa o desactiva el filtro contra zumbidos eléctricos de red."
msgstr "Activa o desactiva el filtro contra zumbidos eléctricos de red."

msgid "Activa o desactiva el filtro subsónico para frecuencias inaudibles."
msgstr "Activa o desactiva el filtro subsónico para frecuencias inaudibles."

msgid "Activa o desactiva el modo de audio mono."
msgstr "Activa o desactiva el modo de audio mono."

msgid "Activa o desactiva el realce de claridad vocal y presencia."
msgstr "Activa o desactiva el realce de claridad vocal y presencia."

msgid "Activa o desactiva la compensación de volumen (Loudness)."
msgstr "Activa o desactiva la compensación de volumen (Loudness)."

msgid "Activa o desactiva la extensión de subgraves profundos (70 Hz)."
msgstr "Activa o desactiva la extensión de subgraves profundos (70 Hz)."

msgid "Activa o desactiva la optimización acústica para la voz de NVDA."
msgstr "Activa o desactiva la optimización acústica para la voz de NVDA."

msgid "Activa o desactiva la preamplificación automática para evitar distorsión."
msgstr "Activa o desactiva la preamplificación automática para evitar distorsión."

msgid "Activa o desactiva rápidamente el ecualizador de audio."
msgstr "Activa o desactiva rápidamente el ecualizador de audio."

msgid "Anuncia por voz el estado completo del ecualizador: perfil activo, preamplificación y mejoras aplicadas."
msgstr "Anuncia por voz el estado completo del ecualizador: perfil activo, preamplificación y mejoras aplicadas."

msgid "Auditoría de conflictos - Ecualizador de Audio"
msgstr "Auditoría de conflictos - Ecualizador de Audio"

msgid "Aumenta el ancho estéreo en 10 %."
msgstr "Aumenta el ancho estéreo en 10 %."

msgid "Aumenta el balance hacia el canal derecho."
msgstr "Aumenta el balance hacia el canal derecho."

msgid "Aumenta la preamplificación manual en 1 dB."
msgstr "Aumenta la preamplificación manual en 1 dB."

msgid "Aumenta los agudos rápidos en 1 dB."
msgstr "Aumenta los agudos rápidos en 1 dB."

msgid "Aumenta los graves rápidos en 1 dB."
msgstr "Aumenta los graves rápidos en 1 dB."

