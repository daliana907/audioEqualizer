msgstr "Ejecuta la comprobación auditiva de canales de audio (izquierdo, derecho y centro)."

msgid "Error - Ecualizador de audio"
msgstr "Error - Ecualizador de audio"

msgid "Invierte o restaura los canales izquierdo y derecho (L/R)."
msgstr "Invierte o restaura los canales izquierdo y derecho (L/R)."

msgid "La documentación no se encuentra disponible."
msgstr "La documentación no se encuentra disponible."

msgid "Mueve el balance hacia el canal izquierdo."
msgstr "Mueve el balance hacia el canal izquierdo."

msgid "No se han detectado conflictos de atajos de teclado con otros complementos activos en este sistema.\n"
"\n"
"Todos los atajos configurados para el Ecualizador de Audio están listos para usarse sin interferencias."
msgstr "No se han detectado conflictos de atajos de teclado con otros complementos activos en este sistema.\n"
"\n"
"Todos los atajos configurados para el Ecualizador de Audio están listos para usarse sin interferencias."

msgid "No se pudo abrir la documentación: {error}"
msgstr "No se pudo abrir la documentación: {error}"

msgid "Restablece la ecualización a una respuesta plana (0 dB)."
msgstr "Restablece la ecualización a una respuesta plana (0 dB)."

