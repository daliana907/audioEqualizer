msgstr "Cambia al perfil de ecualización anterior."

msgid "Cambia al siguiente perfil de ecualización."
msgstr "Cambia al siguiente perfil de ecualización."

msgid "Centra el balance de audio estéreo."
msgstr "Centra el balance de audio estéreo."

msgid "Comprobar conflictos con otros complementos..."
msgstr "Comprobar conflictos con otros complementos..."

msgid "Comprueba si existen conflictos de atajos de teclado con otros complementos."
msgstr "Comprueba si existen conflictos de atajos de teclado con otros complementos."

msgid "Configuración..."
msgstr "Configuración..."

msgid "Conflictos detectados - Ecualizador de Audio"
msgstr "Conflictos detectados - Ecualizador de Audio"

msgid "Descargar e instalar motor de audio (Equalizer APO)..."
msgstr "Descargar e instalar motor de audio (Equalizer APO)..."

